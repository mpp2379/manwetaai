# PostgreSQL
DATABASE_URL=postgresql://neondb_owner:npg_EZBl6ODgPy1h@ep-divine-glade-asif9z23-pooler.c-4.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Flask/JWT
SECRET_KEY=change-this-to-a-long-random-value
JWT_ACCESS_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# RunPod
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_REMOTE_IMAGE_NAME=image.png

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5555/auth/google/callback

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Development: true shows the OTP on the UI/logs instead of sending SMS.
DEV_OTP_MODE=true

# Production SMS provider (Twilio Verify)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

FLASK_ENV=development
FLASK_DEBUG=false
